# Copy this file to .env and set your local API host.
EXPO_PUBLIC_API_URL=http://192.168.2.21:8000/api/
HOST_URL=http://192.168.2.21:8000/

# Stripe Payment Configuration
# Get these from https://dashboard.stripe.com/apikeys
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# Set to true for test mode, false for production
EXPO_PUBLIC_STRIPE_TEST_MODE=true
