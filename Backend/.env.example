# Copy this file to .env and fill your own values.

# Database
URLDBCONNECTION=
MAINDB=impact_db

# Server
BASE_PATH=http://localhost:
PORT=8000

# Collections
USERSCOLLECTION=users
TKNRVKCOLLECTION=tknRvk
VEHICLESCOLLECTION=vehicles
INSURANCESCOLLECTION=insurances
DRIVERSLICENSECOLLECTION=driving_licenses
ACCIDENTREPORTSCOLLECTION=accident_reports

# Security
AES_KEY=
JWTSTKEY=
SECRETKEY_IDQR=
MYSECRETKEY=
MYPRIVATEKEY=
MYPUBLICSECRETKEY=
MYPASSPHRASE=

# Cron expressions
CRONTIMER_EVERYMINUTE=* * * * *
CRONTIMER_EVERYHOUR=0 * * * *
CRONTIMER_EVERY2HOURS=0 */2 * * *
CRONTIMER_EVERY6HOURS=0 */6 * * *
CRONTIMER_EVERY8HOURS=0 */8 * * *
CRONTIMER_EVERY24HOURS=0 0 * * *
CRONTIMER_DAILY1AM=0 1 * * *
CRONTIMER_DAILY3AM=0 3 * * *
CRONTIMER_WEEKLYMON1AM=0 1 * * 1
CRONTIMER_WEEKLYSUNDNIGHT=0 0 * * 0

# Upload paths
USER_ROUTER_IMG_PATH=./uploads/users/images
USER_ROUTER_IMG_IDS_PATH=./uploads/users/images/ids
USER_ROUTER_IMG_PROFILE_PATH=./uploads/users/images/profile
USER_ROUTER_IMG_ACCIDENT_REPPORT_PATH=./uploads/users/images/accident_repport
USER_CONTROLLER_IMG_PATH=../uploads/users/images
USER_CONTROLLER_IMG_PATHX2=../uploads/users/images
CARS_ROUTER_IMG_PATH=./uploads/cars/images
CARS_CONTROLLER_IMG_PATH=../uploads/cars/images
ONFIDO_ROUTER_IMG_PATH=./uploads/onfido/images
ONFIDO_CONTROLLER_IMG_PATH=../uploads/onfido/images
ACCIDENT_IMG_PATH=./uploads/accidents/images
USER_DOC_PATH=/uploads/docs/images
DOCS_ROUTER_DOC_PATH=./uploads/docs/images
VERIFF_ROUTER_PATH=./uploads/docs/pdf

# Mailer
E_SERVICE=gmail
EMAIL=
E_PSSWRD=
SKIP_EMAIL_VERIFICATION=true

# Onfido
ONFIDO_API_TOKEN=

# Veriff
BASE_VERIFF_HTTPS=https://veriff.com
VERIFF_BASE_URL=https://stationapi.veriff.com
VERIFF_FULL_API_PATH=https://stationapi.veriff.com/v1/sessions/
VERIF_API_PUBLIC_KEY=
X_HMAC_SIGNATURE=
